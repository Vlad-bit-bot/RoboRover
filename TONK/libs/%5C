import minimalmodbus
from .dictionary import *

class Connection:

    def __init__(self, port_name):
        
        try:
            self.address = 1
            self.driver = minimalmodbus.Instrument(port_name, self.address)
        except Exception as e:
            print(f"Connection error on {port_name}")
            print(f"Error: e")
            exit()

        self.driver.serial.baudrate = 9600
        self.driver.serial.bytesize = 8
        self.driver.serial.parity = minimalmodbus.serial.PARITY_NONE
        self.driver.stopbits = 1
        self.driver.mode = minimalmodbus.MODE_RTU

        self.driver.clear_buffers_before_each_transation = True

        print(f"\033[1;95mBuna Puuuuuf! :)\033[0m")
    
    def close_port(self):
        self.driver.serial.close()
        print("Port closed!")

    def error(self):
        self.close_port()
        print("Error!")

#################################
#                               #
#   Telemetry data functions    #
#                               #
#################################

#Function used for reading voltage
    def read_voltage(self):
        try:
            voltage = self.driver.read_register(REG_VOLTAGE_GET, functioncode = 3)
            return voltage/10
        except Exception as e:
            self.error()

#Function used for reading current
    def read_current(self): 
        try:
            current = self.driver.read_register(REG_CURRENT_GET, functioncode = 3)
            return current/4
        except Exception as e:
            self.error()


    
